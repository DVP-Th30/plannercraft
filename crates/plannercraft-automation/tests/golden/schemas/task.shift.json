{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "`task.shift` (R-267) : décale `tasks` de `by`.",
  "properties": {
    "by": {
      "additionalProperties": false,
      "description": "Décalage **signé** : texte (« 1j », « -1sem », « +2d », « 3ej ») ou\nminutes signées (`-480`) avec unité ; jours ouvrés du calendrier de\nchaque tâche (temps civil si écoulé) ; pas de pourcentage ni de\n« ? ».",
      "properties": {
        "elapsed": {
          "description": "Durée écoulée (« 5ej »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "estimated": {
          "description": "Durée estimée (« 5j? »).",
          "type": [
            "boolean",
            "null"
          ]
        },
        "minutes": {
          "description": "Minutes (ouvrées, ou écoulées si `elapsed`).",
          "format": "int64",
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "Texte à la manière de MS Project (« 5j », « 2d? »).",
          "type": [
            "string",
            "null"
          ]
        },
        "unit": {
          "anyOf": [
            {
              "description": "Unité d'une durée en JSON.",
              "oneOf": [
                {
                  "const": "minute",
                  "description": "Minute.",
                  "type": "string"
                },
                {
                  "const": "hour",
                  "description": "Heure.",
                  "type": "string"
                },
                {
                  "const": "day",
                  "description": "Jour.",
                  "type": "string"
                },
                {
                  "const": "week",
                  "description": "Semaine.",
                  "type": "string"
                },
                {
                  "const": "month",
                  "description": "Mois.",
                  "type": "string"
                }
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Unité d'affichage."
        }
      },
      "type": "object"
    },
    "tasks": {
      "description": "Tâches à décaler (une récapitulative vaut ses feuilles).",
      "items": {
        "description": "Tâche : UID (entier) ou étiquette \"$x\" d'une tâche créée plus tôt dans le même lot.",
        "oneOf": [
          {
            "maximum": 4294967295,
            "minimum": 1,
            "type": "integer"
          },
          {
            "pattern": "^\\$[A-Za-z0-9_-]{1,64}$",
            "type": "string"
          }
        ]
      },
      "type": "array"
    }
  },
  "required": [
    "tasks",
    "by"
  ],
  "title": "TaskShift",
  "type": "object"
}
